# PortionPair environment variables
#
# Copy to `.env.local` and fill in. Never commit `.env.local` or real secrets.
# Only NEXT_PUBLIC_* values reach the browser — everything else stays server-side
# (CLAUDE.md §17).
#
# Each block below is listed with the milestone that turns it on. Blocks past
# Milestone 2 are still unused — nothing reads them yet.

# --- Milestone 2: Supabase auth and persisted households (required now) ---
# Create a project at supabase.com, run the migration in
# supabase/migrations/, then copy these from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Not used by any code yet — every read/write in this milestone runs as the
# signed-in user through RLS. Uncomment when a server-only, RLS-bypassing
# operation actually needs it.
# SUPABASE_SERVICE_ROLE_KEY=      # server only — never expose to the browser

# --- Milestone 3: verified nutrition data ---
# USDA_FDC_API_KEY=

# --- Milestone 4: structured AI meal proposals ---
# OPENAI_API_KEY=
# OPENAI_MODEL=                   # selected against a strict cost ceiling

# --- Milestone 5: billing, email, and instrumentation ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# RESEND_API_KEY=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# SENTRY_DSN=
